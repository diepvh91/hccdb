# Google Gemini API Key
# Lay tu: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# Turso Database (libSQL)
# Tao database: npx turso db create hcc-db
# Lay URL: npx turso db show hcc-db
TURSO_DATABASE_URL=libsql://hcc-db-xxx.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Vercel Blob Storage
# Lay token: https://vercel.com/dashboard → Storage → Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token_here

# Port chay ung dung (mac dinh: 3000)
PORT=3000

# Moi truong (development hoac production)
NODE_ENV=development
